{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@common/*": [
        "src/common/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@database/*": [
        "src/database/*"
      ],
      "@decorators/*": [
        "src/common/decorators/*"
      ],
      "@transformers/*": [
        "src/common/transformers/*"
      ],
      "@filters/*": [
        "src/common/filters/*"
      ],
      "@guards/*": [
        "src/common/guards/*"
      ],
      "@interceptors/*": [
        "src/common/interceptors/*"
      ],
    
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test",
    // Tests are typechecked by tsconfig.spec.json, which adds jest's globals.
    // They were inside this config's `include`, so every `tsc --noEmit`
    // printed ~98 permanent errors (`Cannot find name 'describe'`) that had
    // to be filtered by eye — which is how a real error goes unnoticed.
    // They are never emitted into dist either way.
    "src/**/__tests__/**",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
